# ==============================================================================
# LeadPilot Environment Configuration Template
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@endpoint.region.neon.tech/neondb?sslmode=require"

# Discovery Provider Priority & Selection
# Options: "rapidapi" (primary, default) | "google_places"
PRIMARY_DISCOVERY_PROVIDER="rapidapi"

# RapidAPI Maps Data — Primary Discovery Provider
RAPIDAPI_ENABLED=true
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=maps-data.p.rapidapi.com
RAPIDAPI_ENDPOINT_PATH=/searchmaps.php
RAPIDAPI_TIMEOUT_MS=15000
RAPIDAPI_CONCURRENCY=2
RAPIDAPI_MOCK_MODE=false

# Global Lead Limits & Geographic Targeting
MAX_LEADS_PER_RUN=20
ALLOWED_DISCOVERY_COUNTRIES=IN,US,CA

# Google Places API (New) — Modular / Future Provider (Disabled by default)
# Google Places makes zero network calls and requires no key while disabled.
# To activate in the future:
# 1. Set GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# 2. Set GOOGLE_PLACES_ENABLED=true
# 3. Set PRIMARY_DISCOVERY_PROVIDER="google_places" (or keep "rapidapi")
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=8000
GOOGLE_PLACES_CONCURRENCY=3

# OpenStreetMap (Overpass API) — Secondary / Fallback Discovery Provider
OSM_ENABLED=true
OSM_TIMEOUT_MS=6000
OSM_CONCURRENCY=2
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_FALLBACKS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# Google PageSpeed Insights API (v5) — Website Performance & Core Web Vitals (Optional)
PAGESPEED_API_KEY=

# Internal Crawler Settings
WEBSITE_CRAWL_PAGE_LIMIT=2

# Phone Verification — Twilio Lookup (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email Verification — ZeroBounce (Optional)
ZEROBOUNCE_API_KEY=

# Contact Verification Control Flags (Optional)
CONTACT_PHONE_EXTERNAL_VERIFICATION=true
CONTACT_EMAIL_EXTERNAL_VERIFICATION=false

# Contact Enrichment Waterfall API Keys
PROSPEO_API_KEY=
TOMBA_API_KEY=
FINDYMAIL_API_KEY=
ICYPEAS_API_KEY=

