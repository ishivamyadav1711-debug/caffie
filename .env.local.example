# ==============================================================================
# LeadPilot - Local Environment Setup Template (.env.local.example)
# Copy this file to .env.local to configure your local development environment.
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
# Required for running the app locally and storing leads/outreach history.
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@endpoint.region.neon.tech/neondb?sslmode=require"

# Discovery Provider Priority & Selection
# Options: "rapidapi" (primary, default) | "google_places"
PRIMARY_DISCOVERY_PROVIDER="rapidapi"

# RapidAPI Maps Data (Primary Discovery Provider)
# Set your RapidAPI key here. Leave RAPIDAPI_MOCK_MODE=false when using a real key.
# If you do not have a real RapidAPI key yet, set RAPIDAPI_MOCK_MODE=true for safe local testing.
RAPIDAPI_ENABLED=true
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=maps-data.p.rapidapi.com
RAPIDAPI_ENDPOINT_PATH=/searchmaps.php
RAPIDAPI_TIMEOUT_MS=15000
RAPIDAPI_CONCURRENCY=2
RAPIDAPI_MOCK_MODE=false

# Global Limits & Geographic Constraints
MAX_LEADS_PER_RUN=20
ALLOWED_DISCOVERY_COUNTRIES=IN,US,CA

# Google Places API (New) - Modular / Future Provider (Disabled by default)
# When disabled, Google Places makes zero network calls and requires no key.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=8000
GOOGLE_PLACES_CONCURRENCY=3

# OpenStreetMap / Overpass (Reliable Fallback Discovery Provider)
# Active as secondary/fallback provider when primary provider yields insufficient results.
OSM_ENABLED=true
OSM_TIMEOUT_MS=6000
OSM_CONCURRENCY=2
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_FALLBACKS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
