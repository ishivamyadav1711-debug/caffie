generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id               String               @id @default(cuid())
  name             String
  legalName        String?
  category         String
  industry         String
  address          String?
  city             String?
  state            String?
  country          String               @default("India")
  postcode         String?
  latitude         Float?
  longitude        Float?
  phone            String?
  email            String?
  websiteUrl       String?
  rating           Float?
  reviewCount      Int?
  businessStatus   String               @default("OPERATIONAL")
  opportunityScore Int                  @default(0)
  status           String               @default("New")
  firstKnownGmvDate String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sources          BusinessSource[]
  contacts         Contact[]
  evidence         LeadEvidence[]
  scores           LeadScore[]
  signals          MarketingSignal[]
  outreach         Outreach[]
  outreachLogs     OutreachAuditLog[]
  verifications    VerificationResult[]
  websites         Website[]
  audits           WebsiteAudit[]
  campaignLeads    CampaignLead[]
  inboundReplies   InboundReply[]
  emailEvents      EmailEvent[]
  meetings         Meeting[]
  demos            WebsiteDemo[]
  commercialMilestones CommercialMilestone[]

  @@index([city, state])
  @@index([industry])
  @@index([opportunityScore])
}

model BusinessSource {
  id          String   @id @default(cuid())
  businessId  String
  provider    String
  sourceId    String
  sourceUrl   String?
  rawPayload  String?
  collectedAt DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([provider, sourceId])
}

model Contact {
  id                 String               @id @default(cuid())
  businessId         String
  name               String?
  role               String?
  contactType        String               @default("PHONE")       // PHONE | EMAIL | WHATSAPP | CONTACT_FORM | SOCIAL | OTHER
  type               String               @default("GENERIC_BUSINESS")
  rawValue           String?
  normalizedValue    String?
  email              String?
  phone              String?
  linkedin           String?
  domain             String?
  countryCode        String?
  lineType           String?              // MOBILE | LANDLINE | VOIP | UNKNOWN
  source             String?              // google_places | osm | official_website | web_search
  sourceUrl          String?
  sourceProvider     String?              // Provider name that discovered this contact
  confidence         Float                @default(0.0)
  verificationStatus String               @default("UNVERIFIED")  // UNKNOWN | UNVERIFIED | VERIFIED | INVALID | RISKY | BOUNCED | DISPOSABLE | ROLE_BASED | UNAVAILABLE
  verifiedAt         DateTime?
  firstDiscoveredAt  DateTime             @default(now())
  lastCheckedAt      DateTime?
  isPrimary          Boolean              @default(false)
  isPublic           Boolean              @default(true)
  isRoleBased        Boolean              @default(false)
  isDisposable       Boolean              @default(false)
  evidence           String?              // JSON: extraction evidence snippet
  metadata           String?              // JSON: additional provider-specific data
  createdAt          DateTime             @default(now())
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  verifications      VerificationResult[]
  contactVerifications ContactVerification[]

  @@index([businessId])
  @@index([contactType, verificationStatus])
  @@index([normalizedValue])
}

model ContactVerification {
  id                String    @id @default(cuid())
  contactId         String
  type              String?               // PHONE | EMAIL
  normalizedValue   String?
  provider          String                // dns_mx | libphonenumber | twilio_lookup | zerobounce | hunter | internal
  status            String                // VERIFIED | INVALID | RISKY | UNKNOWN | DISPOSABLE | ROLE_BASED | BOUNCED | UNAVAILABLE | FORMAT_VALID | DOMAIN_VALID | MX_VALID | DELIVERABILITY_VERIFIED
  level             String    @default("SYNTAX")  // SYNTAX | DOMAIN | MX | DELIVERABILITY | CARRIER
  providerStatus    String?               // READY | NOT_CONFIGURED | RATE_LIMITED | TIMEOUT | AUTH_FAILED | PROVIDER_ERROR | QUOTA_EXCEEDED | UNAVAILABLE
  providerRequestId String?
  errorCode         String?
  hasValidSyntax    Boolean   @default(false)
  hasMxRecords      Boolean?
  isDisposable      Boolean   @default(false)
  isRoleBased       Boolean   @default(false)
  lineType          String?               // MOBILE | LANDLINE | VOIP | UNKNOWN
  carrier           String?
  confidence        Float     @default(0.0)
  evidence          String?               // Raw verification evidence snippet / reason
  details           String?               // JSON: provider-specific details
  verifiedAt        DateTime  @default(now())
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  contact           Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([provider])
  @@index([normalizedValue, provider])
  @@index([expiresAt])
}

model Website {
  id            String         @id @default(cuid())
  businessId    String
  url           String
  domain        String
  isHttps       Boolean        @default(false)
  httpStatus    Int?
  status        String         @default("Working")
  lastCheckedAt DateTime       @default(now())
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  audits        WebsiteAudit[]

  @@index([businessId])
  @@index([domain])
}

model WebsiteAudit {
  id                 String   @id @default(cuid())
  businessId         String
  websiteId          String?
  url                String
  status             String   @default("Working")
  performanceScore   Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  seoScore           Int?
  responseTimeMs     Int?
  hasMobileViewport  Boolean  @default(false)
  hasContactForm     Boolean  @default(false)
  hasBookingCta      Boolean  @default(false)
  hasPhoneCta        Boolean  @default(false)
  hasWhatsappLink    Boolean  @default(false)
  detectedIssues     String
  rawAuditPayload    String?
  auditedAt          DateTime @default(now())
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website            Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model MarketingSignal {
  id         String   @id @default(cuid())
  businessId String
  signalType String
  name       String
  value      String
  sourceUrl  String?
  confidence Float    @default(1.0)
  observedAt DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model VerificationResult {
  id          String   @id @default(cuid())
  businessId  String
  contactId   String?
  targetType  String
  targetValue String
  provider    String
  status      String
  details     String?
  confidence  Float    @default(1.0)
  verifiedAt  DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact     Contact? @relation(fields: [contactId], references: [id])

  @@index([businessId])
}

model LeadScore {
  id                  String   @id @default(cuid())
  businessId          String
  opportunityScore    Int      @default(0)
  fitScore            Int      @default(0)
  needScore           Int      @default(0)
  contactabilityScore Int      @default(0)
  evidenceScore       Int      @default(0)
  reasons             String
  calculatedAt        DateTime @default(now())
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model LeadEvidence {
  id           String   @id @default(cuid())
  businessId   String
  evidenceType String
  claim        String
  sourceUrl    String?
  snippet      String?
  confidence   Float    @default(1.0)
  observedAt   DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Outreach {
  id                 String             @id @default(cuid())
  businessId         String
  campaignId         String?
  channel            String             @default("EMAIL")
  recipient          String
  subject            String?
  message            String
  status             String             @default("PENDING")
  provider           String?
  providerMessageId  String?
  gmailMessageId     String?
  gmailThreadId      String?
  verificationStatus String?
  evidenceUsed       String?
  errorCode          String?
  errorMessage       String?
  excelSyncStatus    String?            @default("PENDING")
  excelSyncError     String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign           Campaign?          @relation(fields: [campaignId], references: [id])
  auditLogs          OutreachAuditLog[]
  inboundReplies     InboundReply[]
  emailEvents        EmailEvent[]
  senderAccountId    String?
  senderAccount      SenderAccount?     @relation(fields: [senderAccountId], references: [id])

  @@index([businessId])
  @@index([campaignId])
  @@index([channel, recipient])
  @@index([status])
  @@index([senderAccountId])
  @@index([gmailThreadId])
}

model Campaign {
  id              String         @id @default(cuid())
  userId          String?
  senderAccountId String?
  name            String
  description     String?
  status          String         @default("ACTIVE")
  scheduleType    String         @default("IMMEDIATE")
  dailyLimit      Int            @default(50)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User?          @relation(fields: [userId], references: [id])
  senderAccount   SenderAccount? @relation(fields: [senderAccountId], references: [id])
  outreaches      Outreach[]
  campaignLeads   CampaignLead[]
  steps           CampaignStep[]
  replies         InboundReply[]
  events          EmailEvent[]
  meetings        Meeting[]

  @@index([userId])
  @@index([senderAccountId])
}

model SuppressionList {
  id        String   @id @default(cuid())
  contact   String
  channel   String   @default("ALL")
  reason    String
  source    String?
  createdAt DateTime @default(now())

  @@unique([contact, channel])
  @@index([contact])
}

model OutreachAuditLog {
  id         String    @id @default(cuid())
  userId     String?
  businessId String
  outreachId String?
  action     String
  channel    String
  provider   String?
  metadata   String?
  timestamp  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outreach   Outreach? @relation(fields: [outreachId], references: [id])

  @@index([businessId])
  @@index([outreachId])
  @@index([action])
}

model Job {
  id              String        @id @default(cuid())
  type            String        @default("LEAD_SEARCH")
  status          String        @default("PENDING")
  criteria        String
  totalDiscovered Int           @default(0)
  totalProcessed  Int           @default(0)
  totalQualified  Int           @default(0)
  error           String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  pipelineRuns    PipelineRun[]
}

model PipelineRun {
  id               String     @id @default(cuid())
  jobId            String
  status           String     @default("RUNNING")
  stage            String     @default("TARGET_CREATED")
  recordsProcessed Int        @default(0)
  recordsFailed    Int        @default(0)
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  error            String?
  actorRuns        ActorRun[]
  job              Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ActorRun {
  id            String      @id @default(cuid())
  pipelineRunId String
  actorName     String
  status        String      @default("RUNNING")
  inputCount    Int         @default(0)
  outputCount   Int         @default(0)
  durationMs    Int         @default(0)
  error         String?
  createdAt     DateTime    @default(now())
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId])
}

model SearchResultHistory {
  id             String   @id @default(cuid())
  placeId        String
  jobId          String
  fingerprintKey String
  businessName   String
  deliveredAt    DateTime @default(now())

  @@index([fingerprintKey])
  @@index([placeId])
  @@index([deliveredAt])
}

model CampaignLead {
  id                String    @id @default(cuid())
  campaignId        String
  leadId            String
  status            String    @default("PENDING") // PENDING | IN_PROGRESS | PAUSED | STOPPED | COMPLETED | FAILED
  currentStep       Int       @default(0)
  stopReason        String?   // INTERESTED | NOT_INTERESTED | UNSUBSCRIBE | BOUNCED | MEETING_BOOKED | MANUAL | OOO
  customSubject     String?
  customBody        String?
  aiPersonalization String?   // JSON metadata
  lastContactedAt   DateTime?
  nextFollowupAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead              Business  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
  @@index([status])
  @@index([nextFollowupAt])
}

model CampaignStep {
  id                   String   @id @default(cuid())
  campaignId           String
  stepNumber           Int      // 1, 2, 3...
  delayDays            Int      @default(0) // days after previous step
  channel              String   @default("EMAIL")
  templateSubject      String?
  templateBody         String
  useAiPersonalization Boolean  @default(true)
  createdAt            DateTime @default(now())
  campaign             Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

model InboundReply {
  id                   String    @id @default(cuid())
  campaignId           String?
  leadId               String?
  outreachId           String?
  provider             String    // resend | sendgrid | inbound_smtp | generic
  providerEventId      String?
  messageId            String?
  threadId             String?
  inReplyTo            String?
  fromEmail            String
  toEmail              String
  subject              String
  bodyText             String
  bodyHtml             String?
  classification       String    @default("UNKNOWN") // INTERESTED | NOT_INTERESTED | QUESTION | OOO | NEEDS_INFO | WRONG_PERSON | UNSUBSCRIBE | BOUNCE | NEGOTIATION | MEETING_REQUEST | UNKNOWN
  confidence           Float     @default(0.0)
  classificationReason String?
  actionTaken          String?   // STOPPED_CAMPAIGN | SCHEDULED_MEETING | CREATED_DRAFT | RESCHEDULED_OOO | SUPPRESSED | HUMAN_REVIEW
  aiDraftResponse      String?
  isApproved           Boolean   @default(false)
  receivedAt           DateTime  @default(now())
  createdAt            DateTime  @default(now())
  campaign             Campaign? @relation(fields: [campaignId], references: [id])
  lead                 Business? @relation(fields: [leadId], references: [id])
  outreach             Outreach? @relation(fields: [outreachId], references: [id])
  meetings             Meeting[]

  @@index([campaignId])
  @@index([leadId])
  @@index([outreachId])
  @@index([classification])
  @@index([fromEmail])
}

model EmailEvent {
  id              String    @id @default(cuid())
  campaignId      String?
  leadId          String?
  outreachId      String?
  eventType       String    // EMAIL_QUEUED | EMAIL_SENT | EMAIL_DELIVERED | EMAIL_BOUNCED | EMAIL_OPENED | EMAIL_CLICKED | EMAIL_RECEIVED | REPLY_CLASSIFIED | MEETING_BOOKED | MEETING_COMPLETED | LEAD_CONVERTED
  provider        String?
  providerEventId String?
  metadata        String?
  createdAt       DateTime  @default(now())
  campaign        Campaign? @relation(fields: [campaignId], references: [id])
  lead            Business? @relation(fields: [leadId], references: [id])
  outreach        Outreach? @relation(fields: [outreachId], references: [id])

  @@index([campaignId])
  @@index([leadId])
  @@index([eventType])
  @@index([createdAt])
}

model Meeting {
  id               String        @id @default(cuid())
  leadId           String
  campaignId       String?
  replyId          String?
  title            String
  status           String        @default("REQUESTED") // REQUESTED | PROPOSED | SCHEDULED | RESCHEDULED | CANCELLED | COMPLETED | NO_SHOW
  startTime        DateTime?
  endTime          DateTime?
  timeZone         String        @default("Asia/Kolkata")
  meetingUrl       String?
  calendarProvider String?       // google_calendar | internal
  calendarEventId  String?
  attendeeEmail    String
  attendeeName     String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lead             Business      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign         Campaign?     @relation(fields: [campaignId], references: [id])
  reply            InboundReply? @relation(fields: [replyId], references: [id])

  @@index([leadId])
  @@index([campaignId])
  @@index([status])
}

model WebsiteDemo {
  id                  String   @id @default(cuid())
  leadId              String
  previewSlug         String   @unique
  businessName        String
  industry            String
  originalUrl         String?
  status              String   @default("GENERATING") // REQUESTED | GENERATING | BUILDING | READY | FAILED | EXPIRED
  htmlContent         String?
  cssContent          String?
  previewUrl          String?
  improvementsApplied String?  // JSON array of audit issues addressed
  errorMessage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lead                Business @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([previewSlug])
  @@index([status])
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  image          String?
  role           String          @default("USER")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  senderAccounts SenderAccount[]
  campaigns      Campaign[]
  domainHealths  DomainHealth[]

  @@index([email])
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String    @default("oauth")
  provider          String    // "google"
  providerAccountId String    // Google user ID / sub
  refreshToken      String?
  accessToken       String?
  tokenExpiry       DateTime?
  scope             String?
  idToken           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SenderAccount {
  id                String     @id @default(cuid())
  userId            String
  provider          String     @default("gmail") // "gmail" | "google_workspace"
  email             String     // authorized Gmail address
  displayName       String?
  providerAccountId String?    // Google user ID / sub
  accessToken       String
  refreshToken      String?
  tokenExpiry       DateTime?
  scopes            String     // "https://www.googleapis.com/auth/gmail.send ..."
  status            String     @default("CONNECTED") // "CONNECTED" | "DISCONNECTED" | "EXPIRED" | "REVOKED"
  lastError         String?
  lastUsedAt        DateTime?
  
  // Adaptive Capacity
  currentCapacity   Int        @default(25)
  startingCapacity  Int        @default(25)
  configuredMaximum Int        @default(200)
  incrementStep     Int        @default(5)
  healthState       String     @default("HEALTHY") // HEALTHY, WARNING, CRITICAL, PAUSED, REAUTH_REQUIRED, ERROR
  lastHealthEvaluation DateTime?
  lastCapacityChange   DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns         Campaign[]
  outreaches        Outreach[]
  capacityHistory   CapacityHistory[]

  @@unique([userId, email, provider])
  @@index([userId])
  @@index([email])
  @@index([status])
}

model CommercialMilestone {
  id                 String   @id @default(cuid())
  businessId         String
  milestoneType      String   
  gmvAmount          Float?
  gmvCurrency        String?
  eventDate          String?  
  dateAccuracy       String?  
  verificationStatus String   @default("UNVERIFIED") 
  confidence         Float    @default(0.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  evidence           CommercialEvidence[]

  @@index([businessId])
  @@index([milestoneType])
  @@index([eventDate])
  @@index([verificationStatus])
}

model CommercialEvidence {
  id                  String   @id @default(cuid())
  milestoneId         String
  sourceUrl           String
  sourceTitle         String?
  sourcePublisher     String?
  sourcePublishedDate String?
  evidenceText        String?
  evidenceContext     String?
  sourceTier          String?
  verificationStatus  String   @default("UNVERIFIED")
  createdAt           DateTime @default(now())
  
  milestone           CommercialMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model CapacityHistory {
  id               String        @id @default(cuid())
  senderAccountId  String
  previousCapacity Int
  newCapacity      Int
  reason           String
  healthState      String
  createdAt        DateTime      @default(now())

  senderAccount    SenderAccount @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

  @@index([senderAccountId])
  @@index([createdAt])
}

model DomainHealth {
  id                   String    @id @default(cuid())
  userId               String?
  domain               String    @unique
  parentDomain         String?
  
  // DNS Status
  spfStatus            String    @default("UNKNOWN") // PASS, FAIL, UNKNOWN
  spfRecord            String?
  dkimStatus           String    @default("UNKNOWN") // PASS, FAIL, UNKNOWN
  dkimSelector         String?
  dkimRecord           String?
  dmarcStatus          String    @default("UNKNOWN") // PASS, FAIL, UNKNOWN
  dmarcRecord          String?
  dnsLastCheckedAt     DateTime?
  
  // Postmaster Status
  postmasterConnected  Boolean   @default(false)
  postmasterVerified   Boolean   @default(false)
  postmasterLastSyncAt DateTime?
  postmasterLastError  String?
  domainReputation     String?
  spamRate             Float?
  deliveryErrors       Float?
  complianceStatus     String?

  // Overall Health
  healthState          String    @default("HEALTHY") // HEALTHY, WARNING, RESTRICTED, CRITICAL, PAUSED, UNKNOWN
  lastEvaluation       DateTime?
  lastAlertAt          DateTime?
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots            DomainHealthSnapshot[]

  @@index([userId])
  @@index([healthState])
}

model DomainHealthSnapshot {
  id                   String    @id @default(cuid())
  domainId             String
  checkedAt            DateTime  @default(now())
  spfStatus            String
  dkimStatus           String
  dmarcStatus          String
  postmasterAvailable  Boolean   @default(false)
  domainReputation     String?
  ipReputation         String?
  spamRate             Float?
  deliveryErrors       Float?
  authenticationStatus String?
  complianceStatus     String?
  rawProviderStatus    String?
  source               String    // DNS, POSTMASTER
  createdAt            DateTime  @default(now())

  domain               DomainHealth @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId])
  @@index([checkedAt])
}


